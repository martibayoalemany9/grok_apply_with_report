# Copy to credentials_local.env (or export in shell) — never commit real keys.
# Rented Galaxy S26 (or any Android) for complete_apply via Appium.

APPLY_BROWSER=cloud_mobile
CLOUD_DEVICE_PROVIDER=lambdatest
# CLOUD_DEVICE_PROVIDER=browserstack
# CLOUD_DEVICE_PROVIDER=sauce
# CLOUD_DEVICE_PROVIDER=generic

# Exact name must match the provider device catalog (Live UI / docs).
CLOUD_DEVICE_NAME=Galaxy S26
# CLOUD_PLATFORM_VERSION=16
CLOUD_BROWSER=Chrome
CLOUD_BUILD_NAME=karlsruhe-job-apply
CLOUD_SESSION_NAME=complete_apply_s26
CLOUD_IDLE_TIMEOUT_SEC=300

# --- LambdaTest / TestMu AI ---
LT_USERNAME=
LT_ACCESS_KEY=

# --- BrowserStack ---
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=

# --- Sauce Labs ---
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=
# SAUCE_REGION=us-west-1

# --- Generic / local Appium ---
# APPIUM_HUB_URL=http://127.0.0.1:4723/wd/hub

# Apply behaviour (same as desktop complete_apply)
COMPLETE_MAX=3
PER_APP_MAX_SEC=240
DWELL_SEC=80
COMMIT_SEC=50
SKIP_WORKDAY=1
ONE_PER_COMPANY=1
SKIP_ATTEMPTED=1
USE_CHATBOT=0
# COMPLETE_QUEUE_CSV=applications_eu_all.csv
